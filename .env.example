# =========================================================
# .env.example — Template variabel lingkungan
# Salin file ini ke .env.local dan isi nilai yang sesuai.
# JANGAN commit .env.local ke version control.
# =========================================================

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------
# Database PostgreSQL (Supabase / Neon / Self-hosted)
# Digunakan untuk pencarian kamus 17.650+ lema
# ---------------------------------------------------------
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------
# Layanan Penerjemah (Pilih salah satu)
# ---------------------------------------------------------
# 1. Local / Self-hosted NLLB-200 (Python FastAPI)
NLLB_SERVICE_URL=http://127.0.0.1:8001

# 2. Atau gunakan Google Cloud Translation API (set TRANSLATION_PROVIDER=google)
TRANSLATION_PROVIDER=
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TTS_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=

# -------------------------------------------------------------------
# KBJI (Kamus Bahasa Jawa–Indonesia) — Balai Bahasa Provinsi DIY
# Website : https://kbji.kemendikdasmen.go.id/
# Kontak  : balaibahasadiy@kemendikdasmen.go.id | +62274562070
#
# Cara mendapatkan API key:
#   1. Buka https://kbji.kemendikdasmen.go.id/
#   2. Cari bagian "API KBJI untuk Pengembang"
#   3. Daftar sebagai mitra / pengembang
#   4. Setelah mendapat API key, isi nilai di bawah ini
#
# PENTING: Jangan gunakan NEXT_PUBLIC_KBJI_API_KEY — key ini
#          HANYA boleh dibaca di server-side (Next.js Route Handler).
#          Jangan pernah mengeksposnya ke browser.
# -------------------------------------------------------------------
KBJI_API_KEY=
